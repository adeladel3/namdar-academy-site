{"version":1,"users":{"u_48ypyo3hmo1yhrfp":{"id":"u_48ypyo3hmo1yhrfp","phone":"09122787263","name":"مهندس نام‌آور","role":"admin","createdAt":1776372788005}},"orders":{},"otps":{},"enrollments":{},"courses":{"mon":{"slug":"mon","title":"دوره پیشرفته MON","shortDesc":"متدولوژی اختصاصی نامدار برای ترید حرفه‌ای در بازارهای جهانی","longDesc":"دوره MON جامع‌ترین دوره‌ی تخصصی نامدار آکادمی است که طی ۱۶ سال تجربه‌ی تدریس استاد امیرحسین نام‌آور تدوین شده. در این دوره با یک متدولوژی اختصاصی، تحلیل تکنیکال پیشرفته، مدیریت سرمایه و روان‌شناسی ترید را یاد می‌گیرید.","level":"پیشرفته","price":35000000,"duration":"۶ ماه","lessons":84,"students":2450,"instructor":"استاد امیرحسین نام‌آور","image":"/figma/tt6a9115copy2.jpg","badge":"ویژه","chapters":[{"title":"فصل ۱ — مبانی متدولوژی MON","lessons":["معرفی متدولوژی","ساختار بازار","پیدا کردن زون‌های کلیدی","تمرین تحلیل"]},{"title":"فصل ۲ — تحلیل تکنیکال پیشرفته","lessons":["پرایس اکشن","الگوهای هارمونیک","امواج الیوت","اندیکاتورهای ترکیبی"]},{"title":"فصل ۳ — مدیریت سرمایه و ریسک","lessons":["محاسبه حجم پوزیشن","تعیین استاپ‌لاس","مدیریت ریسک به ریوارد","ژورنال معاملاتی"]},{"title":"فصل ۴ — روان‌شناسی ترید","lessons":["کنترل احساسات","صبر در ورود","خارج شدن درست","ساخت ذهنیت برنده"]}]},"lq1":{"slug":"lq1","title":"دوره آموزشی LQ1","shortDesc":"دوره‌ی تخصصی نقدینگی و تحلیل حرکات هوشمند بازار","longDesc":"LQ1 دوره‌ای تخصصی برای درک مفاهیم نقدینگی، شکار نقدینگی (Liquidity Grab) و معاملات هوشمند (Smart Money Concepts) است. این دوره برای تریدرهایی است که می‌خواهند نگاه حرفه‌ای و مدرن به بازار داشته باشند.","level":"پیشرفته","price":24000000,"duration":"۴ ماه","lessons":56,"students":3120,"instructor":"استاد امیرحسین نام‌آور","image":"/figma/lq1bannercopy1.png","badge":"پرفروش","chapters":[{"title":"فصل ۱ — مفاهیم نقدینگی","lessons":["تعریف نقدینگی","نقاط جذب نقدینگی","شکار نقدینگی","تفاوت با پرایس اکشن سنتی"]},{"title":"فصل ۲ — Smart Money Concepts","lessons":["ساختار بازار از دید SMC","Break of Structure و CHoCH","Order Blocks","FVG و Imbalance"]},{"title":"فصل ۳ — استراتژی‌های معاملاتی","lessons":["ستاپ‌های اصلی","مدیریت ورود و خروج","ترکیب با تایم‌فریم بالا","بک‌تست و آماده‌سازی"]}]},"nova":{"slug":"nova","title":"دوره NOVA","shortDesc":"ورود به دنیای معاملات با بنیاد قوی و آموزش گام‌به‌گام","longDesc":"دوره NOVA مخصوص افرادی است که تازه وارد بازارهای مالی شده‌اند. از صفر تا جایی که بتوانید به‌صورت مستقل تحلیل و ترید کنید، همراه شما هستیم.","level":"مقدماتی","price":8500000,"duration":"۲ ماه","lessons":32,"students":5680,"instructor":"تیم آموزشی نامدار","image":"/figma/finvestcopy1.png","badge":"جدید","chapters":[{"title":"فصل ۱ — آشنایی با بازارها","lessons":["فارکس، ارز دیجیتال، بورس","بروکر و کارگزار","ساختار قیمت و کندل‌ها","تایم‌فریم‌ها"]},{"title":"فصل ۲ — تحلیل تکنیکال پایه","lessons":["خطوط روند","سطوح حمایت و مقاومت","الگوهای کلاسیک","فیبوناچی"]},{"title":"فصل ۳ — ورود به ترید","lessons":["باز کردن حساب","پلتفرم متاتریدر","اولین معامله","مدیریت ریسک مبتدی"]}]},"finvest":{"slug":"finvest","title":"دوره FINVEST","shortDesc":"آموزش سرمایه‌گذاری بلندمدت و پرتفوی‌سازی","longDesc":"FINVEST دوره‌ای برای کسانی است که به‌جای معامله‌ی کوتاه‌مدت، به‌دنبال ساخت پرتفوی سرمایه‌گذاری بلندمدت هستند. تحلیل بنیادی، انتخاب دارایی، و مدیریت پرتفوی از موضوعات اصلی است.","level":"متوسط","price":12000000,"duration":"۳ ماه","lessons":42,"students":1850,"instructor":"استاد امیرحسین نام‌آور","image":"/figma/finvestcopy1.png","chapters":[{"title":"فصل ۱ — مبانی سرمایه‌گذاری","lessons":["تفاوت ترید و سرمایه‌گذاری","کلاس‌های دارایی","اصل مرکب‌شدن","افق زمانی"]},{"title":"فصل ۲ — تحلیل بنیادی","lessons":["صورت‌های مالی","نسبت‌های کلیدی","تحلیل صنعت","ارزش‌گذاری"]},{"title":"فصل ۳ — ساخت پرتفوی","lessons":["تخصیص دارایی","تنوع‌بخشی","بازبینی پرتفوی","روانشناسی سرمایه‌گذار"]}]},"psych":{"slug":"psych","title":"روانشناسی ترید","shortDesc":"برنده‌ای ذهنی، معامله‌گری پایدار","longDesc":"بزرگ‌ترین دشمن یک تریدر، خودِ اوست. این دوره روی جنبه‌های روان‌شناختی معامله‌گری تمرکز دارد: کنترل ترس و طمع، نظم ذهنی، و ساخت عادت‌های بر