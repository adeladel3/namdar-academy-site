dAt":1779036127563,"publishedAt":1779036127563},"trading-psychology-mistakes":{"slug":"trading-psychology-mistakes","title":"روان‌شناسی ترید: ۵ اشتباه رایج","excerpt":"چطور از دام‌های احساسی در معاملات جلوگیری کنیم.","content":"اشتباه اول: افزودن به معامله‌ی ضررده (averaging down).\n\nاشتباه دوم: انتقام‌گیری از بازار پس از یک ضرر.\n\nاشتباه سوم: معامله بدون استاپ‌لاس.\n\nاشتباه چهارم: تغییر استراتژی در میانه‌ی معامله.\n\nاشتباه پنجم: نداشتن ژورنال معاملاتی.","category":"روان‌شناسی","coverImage":"/figma/image18.png","readMinutes":5,"published":true,"createdAt":1779036127563,"updatedAt":1779036127563,"publishedAt":1779036127563},"risk-management-basics":{"slug":"risk-management-basics","title":"مبانی مدیریت سرمایه برای تریدرهای مبتدی","excerpt":"بدون مدیریت سرمایه، موفق‌ترین استراتژی هم در بلندمدت ضررده خواهد بود.","content":"مدیریت سرمایه قلب تپنده‌ی یک تریدر موفق است. قانون ۱٪ ریسک در هر معامله، نسبت ریسک به ریوارد حداقل ۱:۲، و حفظ روزانه‌ی سرمایه در این مقاله پوشش داده شده.","category":"آموزش","coverImage":"/figma/image13.png","readMinutes":6,"published":true,"createdAt":1779036127563,"updatedAt":1779036127563,"publishedAt":1779036127563}},"staticPages":{},"callbackRequests":{},"tickets":{},"ticketMessages":{},"salesAgents":{"agent_py76kqu0":{"id":"agent_py76kqu0","name":"مهندس نام‌آور","referralCode":"نامدار","phone":"09122787263","isActive":true,"notes":"نمونه‌ی تستی — برای دیدن داشبورد کارشناس روی کاربر فعلی","createdAt":1779039158898,"updatedAt":1779039461253}},"referralLinks":{"link_lpupx3dc":{"id":"link_lpupx3dc","agentId":"agent_py76kqu0","label":"اصلی","clicks":1,"signups":0,"paidOrders":0,"isActive":true,"createdAt":1779041122344,"updatedAt":1779041122344}},"seminars":{"سمینار-طلا-اصفهان":{"slug":"سمینار-طلا-اصفهان","title":"سمینار ترید طلا در سال ۱۴۰۵","shortTitle":"سمینار طلا اصفهان","shortDesc":"تجربه ۱۷ سال ترید روی طلا مهندس نام‌آور به‌صورت فشرده و عملی داخل این سمینار حضوری با شما اصفهانی‌های عزیز به اشتراک گذاشته می‌شود.","price":490000,"allowPurcha